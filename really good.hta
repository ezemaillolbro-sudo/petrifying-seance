<style>
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{font-family:"Segoe UI",system-ui,Roboto,Arial,sans-serif;color:#eaf0fb;background:#070a12;
 background-image:radial-gradient(700px 520px at 12% -5%,#1b2a56 0,transparent 60%),radial-gradient(700px 520px at 88% 105%,#2b1852 0,transparent 60%),radial-gradient(900px 700px at 50% 50%,#0e1628 0,#070a12 72%);
 display:flex;align-items:center;justify-content:center;height:100vh;overflow:hidden;padding:16px;
 animation:bgIn .8s ease both;-ms-animation:bgIn .8s ease both}
@keyframes bgIn{from{opacity:0}to{opacity:1}}
@-ms-keyframes bgIn{from{opacity:0}to{opacity:1}}
.x{position:fixed;top:12px;right:14px;width:26px;height:26px;line-height:24px;text-align:center;border-radius:9px;
 color:#9aa6bd;font-size:12px;cursor:pointer;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.09);
 transition:color .2s,background .2s,transform .2s;-ms-transition:color .2s,background .2s,-ms-transform .2s}
.x:hover{color:#fff;background:rgba(255,255,255,.11);transform:rotate(90deg);-ms-transform:rotate(90deg)}
.card{position:relative;overflow:hidden;width:100%;max-width:378px;text-align:center;padding:30px 24px 16px;border-radius:22px;
 background:linear-gradient(180deg,rgba(255,255,255,.075),rgba(255,255,255,.02));
 border:1px solid rgba(255,255,255,.10);box-shadow:0 26px 70px rgba(0,0,0,.6);
 animation:cardIn .7s cubic-bezier(.16,.84,.3,1) both;-ms-animation:cardIn .7s cubic-bezier(.16,.84,.3,1) both}
@keyframes cardIn{from{opacity:0;transform:translateY(18px) scale(.955)}to{opacity:1;transform:none}}
@-ms-keyframes cardIn{from{opacity:0;-ms-transform:translateY(18px) scale(.955)}to{opacity:1;-ms-transform:none}}
.card:before{content:"";position:absolute;top:-70%;left:-40%;width:42%;height:240%;pointer-events:none;
 background:linear-gradient(90deg,rgba(255,255,255,0),rgba(255,255,255,.055),rgba(255,255,255,0));
 transform:rotate(16deg);-ms-transform:rotate(16deg);animation:sheen 4.4s ease-in-out infinite;-ms-animation:sheen 4.4s ease-in-out infinite}
@keyframes sheen{0%{left:-45%}55%{left:115%}100%{left:115%}}
@-ms-keyframes sheen{0%{left:-45%}55%{left:115%}100%{left:115%}}
.shield{width:70px;height:70px;margin:0 auto 16px;border-radius:19px;display:flex;align-items:center;justify-content:center;
 background:linear-gradient(140deg,#5b8cff,#8b5cff);position:relative;
 animation:float 4.6s ease-in-out infinite,glow 2.6s ease-in-out infinite;
 -ms-animation:float 4.6s ease-in-out infinite,glow 2.6s ease-in-out infinite}
.shield:before,.shield:after{content:"";position:absolute;top:-6px;left:-6px;right:-6px;bottom:-6px;border-radius:25px;
 border:1px solid rgba(120,150,255,.35)}
.shield:before{animation:ring 2.8s ease-out infinite;-ms-animation:ring 2.8s ease-out infinite}
.shield:after{animation:ring 2.8s ease-out 1.4s infinite;-ms-animation:ring 2.8s ease-out 1.4s infinite}
.shield svg{width:36px;height:36px;animation:breathe 4.6s ease-in-out infinite;-ms-animation:breathe 4.6s ease-in-out infinite}
@keyframes ring{0%{transform:scale(.92);opacity:.85}70%{opacity:.15}100%{transform:scale(1.3);opacity:0}}
@-ms-keyframes ring{0%{-ms-transform:scale(.92);opacity:.85}70%{opacity:.15}100%{-ms-transform:scale(1.3);opacity:0}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
@-ms-keyframes float{0%,100%{-ms-transform:translateY(0)}50%{-ms-transform:translateY(-4px)}}
@keyframes breathe{0%,100%{transform:scale(1)}50%{transform:scale(1.06)}}
@-ms-keyframes breathe{0%,100%{-ms-transform:scale(1)}50%{-ms-transform:scale(1.06)}}
@keyframes glow{0%,100%{box-shadow:0 14px 34px rgba(91,140,255,.30)}50%{box-shadow:0 18px 46px rgba(91,140,255,.55)}}
@-ms-keyframes glow{0%,100%{box-shadow:0 14px 34px rgba(91,140,255,.30)}50%{box-shadow:0 18px 46px rgba(91,140,255,.55)}}
h1{font-size:19px;font-weight:600;text-shadow:0 0 24px rgba(120,160,255,.22)}
.sub{color:#8b96ad;font-size:13px;margin-top:6px;min-height:18px;transition:color .3s;-ms-transition:color .3s}
.progress{height:8px;border-radius:99px;background:rgba(255,255,255,.09);overflow:hidden;margin:18px 0 6px}
.bar{position:relative;height:100%;width:0;border-radius:99px;overflow:hidden;
 background:linear-gradient(90deg,#5b8cff,#8b5cff);transition:width .15s linear;-ms-transition:width .15s linear}
.bar:after{content:"";position:absolute;top:0;bottom:0;left:-60%;width:60%;
 background:linear-gradient(90deg,rgba(255,255,255,0),rgba(255,255,255,.45),rgba(255,255,255,0));
 animation:shimmer 1.35s linear infinite;-ms-animation:shimmer 1.35s linear infinite}
@keyframes shimmer{0%{left:-60%}100%{left:100%}}
@-ms-keyframes shimmer{0%{left:-60%}100%{left:100%}}
.meta{display:flex;justify-content:space-between;font-size:11px;color:#8b96ad}
.steps{list-style:none;margin:14px 0 0;text-align:left}
.steps li{display:flex;align-items:center;font-size:13px;color:#8b96ad;padding:6px 0;opacity:0;
 transform:translateX(-9px);-ms-transform:translateX(-9px);
 transition:opacity .45s ease,transform .5s cubic-bezier(.16,.84,.3,1),color .3s;
 -ms-transition:opacity .45s ease,-ms-transform .5s cubic-bezier(.16,.84,.3,1),color .3s}
.steps li.on{opacity:1;transform:none;-ms-transform:none;color:#eaf0fb}
.steps li.ok{opacity:.8;transform:none;-ms-transform:none}
.dot{width:16px;height:16px;border-radius:50%;border:2px solid rgba(255,255,255,.2);flex:0 0 auto;margin-right:10px;position:relative;
 transition:border-color .3s,background .3s,box-shadow .3s;-ms-transition:border-color .3s,background .3s,box-shadow .3s}
.steps li.on .dot{border-color:#5b8cff;border-top-color:transparent;box-shadow:0 0 12px rgba(91,140,255,.55);
 animation:spin .7s linear infinite;-ms-animation:spin .7s linear infinite}
.steps li.ok .dot{border:0;background:#2bd576;box-shadow:0 0 12px rgba(43,213,118,.5);
 animation:pop .5s cubic-bezier(.2,1.6,.4,1) both;-ms-animation:pop .5s cubic-bezier(.2,1.6,.4,1) both}
.steps li.ok .dot:after{content:"";position:absolute;left:5px;top:2px;width:4px;height:8px;
 border:solid #06210f;border-width:0 2px 2px 0;transform:rotate(45deg);-ms-transform:rotate(45deg);
 animation:tickIn .28s .12s ease both;-ms-animation:tickIn .28s .12s ease both}
@keyframes spin{to{transform:rotate(360deg)}}
@-ms-keyframes spin{to{-ms-transform:rotate(360deg)}}
@keyframes pop{0%{transform:scale(.5)}60%{transform:scale(1.18)}100%{transform:scale(1)}}
@-ms-keyframes pop{0%{-ms-transform:scale(.5)}60%{-ms-transform:scale(1.18)}100%{transform:scale(1)}}
@keyframes tickIn{from{opacity:0;transform:rotate(45deg) scale(.4)}to{opacity:1;transform:rotate(45deg) scale(1)}}
@-ms-keyframes tickIn{from{opacity:0;-ms-transform:rotate(45deg) scale(.4)}to{opacity:1;transform:rotate(45deg) scale(1)}}
.done{display:none}
.done.show{display:block;animation:rise .62s cubic-bezier(.16,.84,.3,1) both;-ms-animation:rise .62s cubic-bezier(.16,.84,.3,1) both}
@keyframes rise{from{opacity:0;transform:translateY(12px) scale(.97)}to{opacity:1;transform:none}}
@-ms-keyframes rise{from{opacity:0;-ms-transform:translateY(12px) scale(.97)}to{opacity:1;-ms-transform:none}}
.checkwrap{position:relative;width:88px;height:88px;margin:2px auto 10px}
.checkwrap:before{content:"";position:absolute;top:-4px;left:-4px;right:-4px;bottom:-4px;border-radius:50%;
 border:2px solid rgba(43,213,118,.55);animation:burst .95s .12s ease-out both;-ms-animation:burst .95s .12s ease-out both}
.checkwrap:after{content:"";position:absolute;top:0;left:0;right:0;bottom:0;border-radius:50%;
 box-shadow:0 0 44px 6px rgba(43,213,118,.35);animation:pulse 2s ease-in-out infinite;-ms-animation:pulse 2s ease-in-out infinite}
@keyframes burst{0%{transform:scale(.7);opacity:.9}100%{transform:scale(1.45);opacity:0}}
@-ms-keyframes burst{0%{-ms-transform:scale(.7);opacity:.9}100%{-ms-transform:scale(1.45);opacity:0}}
@keyframes pulse{0%,100%{opacity:.4}50%{opacity:1}}
@-ms-keyframes pulse{0%,100%{opacity:.4}50%{opacity:1}}
.check{width:88px;height:88px;position:relative;z-index:1}
.ck-c{fill:none;stroke:#2bd576;stroke-width:2.5;stroke-dasharray:151}
.ck-t{fill:none;stroke:#2bd576;stroke-width:3.6;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:40}
.done h2{font-size:19px;font-weight:600;text-shadow:0 0 26px rgba(43,213,118,.25);
 animation:rise .5s .1s cubic-bezier(.16,.84,.3,1) both;-ms-animation:rise .5s .1s cubic-bezier(.16,.84,.3,1) both}
.done p{color:#8b96ad;font-size:13px;margin-top:7px;line-height:1.5;
 animation:rise .5s .18s cubic-bezier(.16,.84,.3,1) both;-ms-animation:rise .5s .18s cubic-bezier(.16,.84,.3,1) both}
.badge{display:inline-block;margin-top:14px;padding:6px 12px;border-radius:99px;font-size:11.5px;color:#bcd0ff;
 background:linear-gradient(100deg,rgba(91,140,255,.1),rgba(139,92,255,.16),rgba(91,140,255,.1));
 background-size:220% 100%;border:1px solid rgba(91,140,255,.25);
 animation:badgeIn .5s .26s cubic-bezier(.16,.84,.3,1) both,shimmerBadge 3.4s linear infinite;
 -ms-animation:badgeIn .5s .26s cubic-bezier(.16,.84,.3,1) both,shimmerBadge 3.4s linear infinite}
@keyframes badgeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
@-ms-keyframes badgeIn{from{opacity:0;-ms-transform:translateY(6px)}to{opacity:1;transform:none}}
@keyframes shimmerBadge{0%{background-position:0% 0}100%{background-position:220% 0}}
@-ms-keyframes shimmerBadge{0%{background-position:0% 0}100%{background-position:220% 0}}
button{position:relative;overflow:hidden;margin-top:16px;width:100%;padding:11px;border:0;border-radius:12px;cursor:pointer;
 font-size:13.5px;font-weight:600;color:#fff;background:linear-gradient(135deg,#5b8cff,#8b5cff);
 box-shadow:0 10px 26px rgba(91,140,255,.3);
 transition:transform .18s cubic-bezier(.16,.84,.3,1),box-shadow .25s;-ms-transition:-ms-transform .18s cubic-bezier(.16,.84,.3,1),box-shadow .25s;
 animation:rise .5s .3s cubic-bezier(.16,.84,.3,1) both;-ms-animation:rise .5s .3s cubic-bezier(.16,.84,.3,1) both}
button:before{content:"";position:absolute;top:0;bottom:0;left:-55%;width:45%;pointer-events:none;
 background:linear-gradient(90deg,rgba(255,255,255,0),rgba(255,255,255,.32),rgba(255,255,255,0));
 transition:left .5s ease;-ms-transition:left .5s ease}
button:hover{transform:translateY(-1px);-ms-transform:translateY(-1px);box-shadow:0 14px 32px rgba(91,140,255,.45)}
button:hover:before{left:115%}
button:active{transform:translateY(1px) scale(.99);-ms-transform:translateY(1px) scale(.99);box-shadow:0 6px 16px rgba(91,140,255,.3)}
.last{margin-top:9px;font-size:11px;color:#8b96ad;animation:rise .5s .42s cubic-bezier(.16,.84,.3,1) both;-ms-animation:rise .5s .42s cubic-bezier(.16,.84,.3,1) both}
.info{margin-top:6px;font-size:11px;color:#7de0a4;min-height:14px;word-break:break-all;
